[Unit]
Description=ATOZAS llama.cpp chat router (Qwen3-4B-Instruct-2507 Q4_K_M; CPU)
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

# Dedicated unprivileged account. Created by deploy/scripts/install-llamacpp.sh.
User=atozas-ai
Group=atozas-ai
WorkingDirectory=/opt/atozas-ai

# ── Thread configuration ──
# --threads is generation (memory-bandwidth bound; more threads stop helping
# early). --threads-batch is prefill (compute bound; scales further).
# Both default to 8 here for the Hostinger KVM 8. Run
# deploy/scripts/benchmark.sh and set these from measured results, not guesses.
Environment=LLAMA_THREADS=8
Environment=LLAMA_THREADS_BATCH=8
Environment=LLAMA_PARALLEL=2

# --ctx-size is the TOTAL context, which llama.cpp divides evenly across the
# --parallel slots. So this must be (per-conversation window x LLAMA_PARALLEL),
# not the window itself: 8192 x 2 = 16384 gives each slot the 8192 tokens that
# LLAMACPP_CONTEXT_WINDOW in server/.env promises the token budgeter.
# Setting it to 8192 here would silently hand each slot only 4096 and truncate
# long conversations. Verify after any change with:
#   journalctl -u atozas-llama | grep n_ctx_slot
# systemd cannot do arithmetic in Environment=, hence the pre-multiplied value.
Environment=LLAMA_CTX_SIZE=16384
# Prevents OpenMP from spawning more threads than we allocated.
Environment=OMP_NUM_THREADS=8

# ── Router mode ──
# Omitting --model is what makes llama-server a router: it fronts port 8081 and
# spawns a child server per model listed in models.ini, routing each request by
# its `model` field.
#
# ATOZAS serves one chat model, so router mode buys no model switching today. It
# is kept because models.ini stays generated from modelRegistry.js, which means
# adding a second model later is a config change rather than a service rewrite.
#
# Raise LLAMA_MODELS_MAX only after checking MemoryMax below: each additional
# resident Q4 4B model is roughly 2.5 GB of weights plus its 16k KV cache.
Environment=LLAMA_MODELS_MAX=1
Environment=LLAMA_MODELS_PRESET=/opt/atozas-ai/app/deploy/llama/models.ini

ExecStart=/opt/atozas-ai/llama.cpp/build/bin/llama-server \
  --models-preset ${LLAMA_MODELS_PRESET} \
  --models-max ${LLAMA_MODELS_MAX} \
  --host 127.0.0.1 \
  --port 8081 \
  --threads ${LLAMA_THREADS} \
  --threads-batch ${LLAMA_THREADS_BATCH} \
  --ctx-size ${LLAMA_CTX_SIZE} \
  --parallel ${LLAMA_PARALLEL} \
  --cont-batching \
  --cache-prompt \
  --mlock \
  --no-webui \
  --metrics \
  --timeout 600 \
  --log-prefix \
  --log-timestamps

# ── Restart policy ──
Restart=always
RestartSec=5
# Give up only after repeated rapid failures, so a bad model file surfaces
# instead of restart-looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

# The router itself starts in seconds; models load lazily on first use, so this
# only has to cover parsing the preset.
TimeoutStartSec=300
# SIGINT lets llama-server finish in-flight slots before exiting.
KillSignal=SIGINT
TimeoutStopSec=30
# control-group, not mixed: the router's per-model child servers must be reaped
# with it, or a restart leaves orphans holding port bindings and gigabytes.
KillMode=control-group

# ── Resource controls ──
# Hard ceiling well under the 32 GB box so a runaway context cannot OOM Mongo,
# Redis or the Node processes.
MemoryMax=12G
MemoryHigh=10G
# The model is nice-d slightly below the API so the box stays responsive under
# full inference load.
Nice=5
CPUWeight=90
IOWeight=80

# ── Hardening ──
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
# Model directory and router preset are read-only to the service; only the
# deploy script writes them.
ReadOnlyPaths=/opt/atozas-ai/models
ReadOnlyPaths=/opt/atozas-ai/app/deploy/llama
# Loopback only — the model must never be reachable from the internet.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --mlock needs the capability to lock pages in memory.
AmbientCapabilities=CAP_IPC_LOCK
CapabilityBoundingSet=CAP_IPC_LOCK
LimitMEMLOCK=infinity

# ── Logging ──
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atozas-llama

[Install]
WantedBy=multi-user.target
