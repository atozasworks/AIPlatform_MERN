{
  "name": "atozas-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ATOZAS AI backend — Express API, self-hosted llama.cpp gateway, BullMQ inference queue, local RAG.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/index.js",
    "start:worker": "node src/worker.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/integration/*.e2e.test.js\"",
    "postinstall": "node scripts/build-auth-kit.mjs"
  },
  "dependencies": {
    "atozas-auth-kit-express": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.2",
    "compression": "^1.7.4",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "nanoid": "^5.0.8",
    "nodemailer": "^9.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
