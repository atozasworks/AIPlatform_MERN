# ─────────────────────────────────────────────────────────────
# ATOZAS AI backend environment — copy to `.env` and fill in values.
# NEVER commit the real .env file.
#
# POLICY: every AI component below must run on ATOZAS-controlled
# infrastructure. The server asserts this at boot (assertSelfHosted in
# src/config/env.js) and refuses to start if an inference URL points at a
# public host. There are no third-party LLM, embedding or reranking APIs.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=production
PORT=5000
BACKEND_URL=https://www.atozasai.com
FRONTEND_URL=https://www.atozasai.com
# Comma-separated CORS allowlist. FRONTEND_URL is always allowed.
CORS_ORIGINS=https://www.atozasai.com,https://atozasai.com

# ── Database ──
MONGO_URI=mongodb://127.0.0.1:27017/atozas

# ── Redis (required: queue, rate limits, stream relay) ──
# Must be bound to 127.0.0.1. Production boot fails on a public address.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=atozas

# ── Auth secrets (generate with: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=.atozasai.com
COOKIE_SECURE=true

# ── Passwordless email OTP login ──
# OTP codes are emailed via SMTP. With Gmail, create an App Password
# (Google Account → Security → 2-Step Verification → App passwords) and use it
# as SMTP_PASS. When EMAIL_ENABLED=false the code is logged, not emailed (dev only).
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=ATOZAS AI <your-gmail-address@gmail.com>
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Google Sign-In ("Continue with Google") ──
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Add your site to "Authorized JavaScript origins" (e.g. https://www.atozasai.com).
# The SAME value must be set for the client build as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# INFERENCE — llama.cpp router (five Q4_K_M chat models) on the ATOZAS VPS
# ─────────────────────────────────────────────────────────────
# Options: llamacpp | gpu
DEFAULT_AI_PROVIDER=llamacpp
# Options: fast | balanced | detailed | rag-grounded | current | coding |
#          summarization | translation
DEFAULT_PROMPT_PROFILE=balanced

LLAMACPP_ENABLED=true
# Port 8080 is commonly taken (XAMPP/Apache in development). 8081 is the standard here.
LLAMACPP_BASE_URL=http://127.0.0.1:8081
# Only needed if llama-server was started with --api-key. Leave empty otherwise.
LLAMACPP_API_KEY=
# Chat models the router serves, comma-separated. Empty = every chat model in
# src/services/ai/modelRegistry.js, which is a single model by design — there is
# no model picker. Leave this blank unless you are deliberately disabling chat.
LLAMACPP_MODELS=
# The served model. Must be an id in src/services/ai/modelRegistry.js, and its
# GGUF must be on this host.
LLAMACPP_MODEL=qwen3-4b-instruct-2507
# Mirrors --models-max on llama-server. ATOZAS serves one model, so 1 is both
# the correct and the only useful value here.
LLAMACPP_MODELS_MAX=1
# How long the cached /v1/models availability snapshot stays fresh.
LLAMACPP_CATALOG_TTL_MS=30000
# Fallback prompt budget for models with no runtime entry in the registry.
# Keep in sync with --ctx-size in the systemd unit.
LLAMACPP_CONTEXT_WINDOW=8192
# Hard ceiling for one generation on CPU before the worker aborts it.
LLAMACPP_REQUEST_TIMEOUT_MS=300000
# Qwen3 reasoning mode. Leave false on CPU: it multiplies token cost and the
# hidden <think> output is stripped before reaching users anyway.
LLAMACPP_THINKING=false

# ── Embeddings: a SECOND llama-server instance, never the chat model ──
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-0.6b
# Must match the model's output width, and must match the vectors already in
# MongoDB. Changing it requires re-ingesting every document.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REQUEST_TIMEOUT_MS=60000
# Retrieval models are asymmetric. Qwen3-Embedding wants an instruction block
# on the query and raw text on the passage; getting this wrong collapses
# similarity toward a constant. dotenv expands the \n because of the quotes.
EMBEDDING_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "
EMBEDDING_PASSAGE_PREFIX=""

# ── Future ATOZAS-owned GPU node (OpenAI wire format, self-hosted only) ──
# Migration is configuration-only: enable, point at the private address, and
# set DEFAULT_AI_PROVIDER=gpu. No code or frontend change required.
GPU_ENABLED=false
GPU_BASE_URL=
GPU_API_KEY=
GPU_MODEL=
GPU_CONTEXT_WINDOW=32768
GPU_REQUEST_TIMEOUT_MS=120000
# Extra hostnames treated as ATOZAS-controlled (comma-separated). Loopback and
# RFC1918 private ranges are always allowed.
SELF_HOSTED_ALLOWED_HOSTS=

# ─────────────────────────────────────────────────────────────
# USAGE AND SAFETY LIMITS
# ─────────────────────────────────────────────────────────────
MAX_ACTIVE_REQUESTS_PER_USER=1
MAX_REQUESTS_PER_MINUTE=5
MAX_REQUESTS_PER_HOUR=40
MAX_QUEUE_SIZE=100
MAX_PROMPT_TOKENS=4000
MAX_OUTPUT_TOKENS_NORMAL=800
MAX_OUTPUT_TOKENS_DETAILED=1500
MAX_CONVERSATION_CONTEXT_TOKENS=6000
MAX_RETRIEVAL_CONTEXT_TOKENS=3000

# THE most important capacity knob: simultaneous CPU generations.
# Must be <= the --parallel value on llama-server. Benchmark before raising.
LLM_WORKER_CONCURRENCY=2

# Drop queued jobs older than this (their clients are gone).
QUEUE_STALE_MS=120000
# How long an SSE relay waits for worker output before closing.
STREAM_IDLE_TIMEOUT_MS=120000
# Keeps proxies from dropping a connection during long CPU prefill.
SSE_HEARTBEAT_MS=15000
JOB_ATTEMPTS=2

# ── Circuit breaker around llama-server ──
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_MS=60000
BREAKER_COOLDOWN_MS=30000

# ─────────────────────────────────────────────────────────────
# LOCAL RAG (MongoDB vectors + hybrid keyword retrieval)
# ─────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=6
RAG_CANDIDATE_LIMIT=200
# Minimum cosine similarity for a dense hit. Raise to reduce weak citations.
# Calibrated for Qwen3-Embedding-0.6B, where relevant passages measured
# 0.53-0.79 and unrelated text 0.09-0.19. Not portable across embedding models:
# re-measure with deploy/scripts/healthcheck.sh style probes after any swap.
RAG_MIN_SCORE=0.45
RAG_CHUNK_TOKENS=380
RAG_CHUNK_OVERLAP_TOKENS=60
# Dense weight in the hybrid score; keyword gets the remainder.
RAG_VECTOR_WEIGHT=0.75
RAG_MAX_UPLOAD_BYTES=2097152
RAG_MAX_DOCUMENTS_PER_USER=200
# In-process similarity cache ceiling (~150 MB at 100k chunks / 384 dims).
RAG_VECTOR_CACHE_MAX_CHUNKS=100000

# ─────────────────────────────────────────────────────────────
# LIVE WEB RETRIEVAL — the only outbound network path in ATOZAS
#
# Why: the model's weights are frozen at its training cutoff, so software
# versions, prices, laws, officeholders and news cannot be answered honestly
# from the model alone. This tier searches a self-hosted SearXNG, extracts the
# pages it finds, reranks the passages, and gives the model dated source text
# with citations.
#
# What leaves the host: a short search query derived from the user's question,
# and HTTP GETs to the public pages the search returned. NEVER a prompt, a
# conversation, or an uploaded document. The model stays on loopback.
#
# Off by default. A deployment that requires zero egress leaves this unset and
# behaves exactly as before.
# ─────────────────────────────────────────────────────────────
WEB_RETRIEVAL_ENABLED=false

# Self-hosted SearXNG. See deploy/searxng/ for a compose file.
# env.js REFUSES TO BOOT if this is not loopback or a private address: a public
# instance would hand every user question to a third party.
SEARXNG_BASE_URL=http://127.0.0.1:8888
# Restrict to specific SearXNG engines (comma-separated). Empty = whatever the
# instance has enabled in settings.yml.
SEARXNG_ENGINES=
# 'news' is added automatically when a question looks news-like.
SEARXNG_CATEGORIES=general
SEARXNG_LANGUAGE=en
SEARXNG_TIMEOUT_MS=8000

# Search hits considered, and how many of those are actually downloaded.
# Fetching is the expensive half, so maxFetch is the latency knob.
WEB_MAX_RESULTS=8
WEB_MAX_FETCH=4
# Passages quoted to the model after reranking. Each costs context that would
# otherwise hold conversation history; 4 fits inside MAX_RETRIEVAL_CONTEXT_TOKENS.
WEB_TOP_PASSAGES=4
# How passages are scored against the question.
#   lexical   (default) BM25-style term overlap. Microseconds, no inference.
#   embedding uses the local embedding server. MEASURED AT ~5.5 SECONDS PER
#             PASSAGE on the ATOZAS CPU box — more than the whole retrieval
#             budget for four passages. Only enable on a GPU or a dedicated
#             embedding host. See server/src/services/web/rerank.js.
WEB_RERANK_MODE=lexical
# Cap on passages scored. Free under lexical scoring; under 'embedding' this is
# what decides whether reranking fits in WEB_TOTAL_BUDGET_MS at all.
WEB_MAX_RERANK_PASSAGES=40

WEB_FETCH_TIMEOUT_MS=6000
WEB_MAX_PAGE_BYTES=2097152
# Ceiling for the whole retrieval phase. The user waits this long before the
# first token, so it trades answer freshness against perceived speed.
WEB_TOTAL_BUDGET_MS=20000

# RECOMMENDED IN PRODUCTION. Empty means retrieval may quote any public host.
# Populated, it is an exclusive allowlist and bounds what the model can cite:
#   WEB_ALLOWED_DOMAINS=nodejs.org,developer.mozilla.org,gov.uk,reuters.com
# Suffix match, so "gov.uk" also allows "www.gov.uk".
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=
WEB_USER_AGENT="ATOZAS-AI/1.0 (+https://atozasai.com; self-hosted retrieval bot)"

# Redis caches. Several users asking the same current-events question in one
# window is the common case, and each hit saves a search plus N page downloads.
WEB_SEARCH_CACHE_TTL_SECONDS=900
WEB_PAGE_CACHE_TTL_SECONDS=3600

# Minimum rerank score for a web passage to be quoted. Leave unset unless you
# have measured your own corpus: the default tracks WEB_RERANK_MODE, because the
# two modes score on unrelated scales (0.15 for lexical query coverage, 0.45 for
# embedding cosine). Setting it explicitly here pins ONE number across both, so a
# later mode switch would silently reject every passage.
# Lower than RAG_MIN_SCORE either way: web text is noisier than curated uploads,
# and search has already applied its own relevance filter.
#WEB_MIN_SCORE=

# ── HTTP rate limiting (separate from the per-user generation limits) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
JSON_BODY_LIMIT=1mb

# ─────────────────────────────────────────────────────────────
# MODEL PROVENANCE — verified by deploy/scripts/fetch-models.sh
# Fill these in after downloading; see deploy/MODELS.md.
# ─────────────────────────────────────────────────────────────
MODEL_SHA256_QWEN3_4B_2507=
MODEL_SHA256_EMBEDDING=
