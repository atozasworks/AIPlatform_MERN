# ─────────────────────────────────────────────────────────────
# AiChat backend environment — copy to `.env` and fill in values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS allowlist (origins). FRONTEND_URL is always allowed.
CORS_ORIGINS=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/aichat

# Redis (optional in Phase 1; used for rate limits / queues in later phases)
REDIS_URL=redis://127.0.0.1:6379

# ── Auth secrets (generate long random strings, e.g. `openssl rand -hex 32`) ──
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie settings
COOKIE_DOMAIN=
COOKIE_SECURE=false        # set true in production (HTTPS)

# ── AI providers (all optional in Phase 1) ──
# If no provider key is present, the built-in MockProvider is used (zero cost).
# Options for DEFAULT_AI_PROVIDER:  llamacpp | groq | openai | mock
# Default is local llama.cpp (local-gguf). Model selector is hidden in the UI.
DEFAULT_AI_PROVIDER=llamacpp
DEFAULT_AI_MODEL=local-gguf

# ── Your own self-hosted model via llama.cpp (no third-party API, fully private) ──
# 1) Build llama.cpp (https://github.com/ggml-org/llama.cpp) and download a .gguf model.
# 2) Start the OpenAI-compatible server, e.g.:
#      llama-server -m ./models/Llama-3.2-3B-Instruct-Q4_K_M.gguf --port 8080
# 3) Set LLAMACPP_ENABLED=true (DEFAULT_AI_PROVIDER already points at llamacpp).
LLAMACPP_ENABLED=true
LLAMACPP_BASE_URL=http://127.0.0.1:8080
# Only needed if you started llama-server with --api-key; otherwise leave as-is.
LLAMACPP_API_KEY=llama.cpp
# Display label for the loaded model (llama-server serves one model at a time).
LLAMACPP_MODEL=local-gguf
# Comma-separated list of extra model labels to show in the selector (optional).
LLAMACPP_MODELS=
LLAMACPP_CONTEXT_WINDOW=8192
# Cap response length (local CPU inference is slow; keeps replies snappy).
LLAMACPP_MAX_TOKENS=512

# Groq (OpenAI-compatible, low latency) — primary provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Later-phase providers (placeholders; not required now) ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# ── Later-phase services (placeholders) ──
SEARCH_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Request size limit
JSON_BODY_LIMIT=1mb
