# ─────────────────────────────────────────────────────────────
# ATOZAS AI backend — copy to `.env` and fill in the values.
# NEVER commit the real .env file.
#
# Only values that change per machine belong here: URLs, secrets,
# and which local services are turned on. Request limits, RAG,
# OTP timing, queue, and breaker settings have defaults in
# src/config/env.js.
#
# Inference URLs must be loopback or a private address. The server
# refuses to start otherwise.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
BACKEND_URL=https://atozasai.com
FRONTEND_URL=https://atozasai.com
CORS_ORIGINS=https://atozasai.com,https://www.atozasai.com

MONGO_URI=mongodb://127.0.0.1:27017/atozas
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=atozas

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_DOMAIN=.atozasai.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

EMAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

GOOGLE_CLIENT_ID=

LLAMACPP_BASE_URL=http://127.0.0.1:8081
LLAMACPP_MODEL=qwen3-4b-instruct-2507
EMBEDDING_BASE_URL=http://127.0.0.1:8082

WEB_RETRIEVAL_ENABLED=false
SEARXNG_BASE_URL=http://127.0.0.1:8888

ATOZAS_SSO_ENABLED=false
ATOZAS_ISSUER=
ATOZAS_CLIENT_ID=
ATOZAS_CLIENT_SECRET=
ATOZAS_REDIRECT_URI=
ATOZAS_AUTHORIZE_URL=
ATOZAS_TOKEN_URL=
ATOZAS_USERINFO_URL=
ATOZAS_REVOKE_URL=
ATOZAS_HOMEPAGE_KEY=
ATOZAS_SESSION_COOKIE_NAME=atozasai_atozas_sid
ATOZAS_SESSION_SECRET=
ATOZAS_COOKIE_SECURE=true
ATOZAS_COOKIE_SAMESITE=lax
