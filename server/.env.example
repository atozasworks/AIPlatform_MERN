# ─────────────────────────────────────────────────────────────
# AiChat backend environment — copy to `.env` and fill in values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS allowlist (origins). FRONTEND_URL is always allowed.
CORS_ORIGINS=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/aichat

# Redis (optional in Phase 1; used for rate limits / queues in later phases)
REDIS_URL=redis://127.0.0.1:6379

# ── Auth secrets (generate long random strings, e.g. `openssl rand -hex 32`) ──
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie settings
COOKIE_DOMAIN=
COOKIE_SECURE=false        # set true in production (HTTPS)

# ── AI providers (all optional in Phase 1) ──
# If no provider key is present, the built-in MockProvider is used (zero cost).
# To use YOUR OWN local model (Ollama), set:  DEFAULT_AI_PROVIDER=ollama
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=llama-3.3-70b-versatile

# ── Your own self-hosted model via Ollama (no third-party API, fully private) ──
# 1) Install Ollama (https://ollama.com/download)
# 2) Pull a model, e.g.:  ollama pull llama3.2:3b
# 3) Set OLLAMA_ENABLED=true and (optionally) switch DEFAULT_AI_PROVIDER=ollama above.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODELS=
OLLAMA_CONTEXT_WINDOW=8192

# Groq (OpenAI-compatible, low latency) — primary provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Later-phase providers (placeholders; not required now) ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# ── Later-phase services (placeholders) ──
SEARCH_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Request size limit
JSON_BODY_LIMIT=1mb
